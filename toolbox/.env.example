# llama.cpp server (OpenAI-compatible API), as seen from the HOST
LLAMA_BASE_URL=http://localhost:8085/v1
# Same server, as seen from INSIDE a container ("localhost" would be the container)
LLAMA_BASE_URL_DOCKER=http://host.docker.internal:8085/v1
LLAMA_MODEL=qwen3
LLAMA_TIMEOUT=120

# Where this app listens. Read by the Makefile and docker-compose.
APP_HOST=127.0.0.1
APP_PORT=8001

# Stand-in for authentication: the identity every request runs as, and the
# permissions it holds (comma-separated). A tool with no required_permission
# is public; one that declares it needs a match here. Leave empty for none.
CALLER_ID=local-dev
CALLER_PERMISSIONS=
